# Copy this file to .env and change the password for local use.
# Never commit .env or real credentials.
POSTGRES_DB=gowander
POSTGRES_USER=gowander
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Used by backend/cmd/api and backend/cmd/migrate.
DATABASE_URL=postgres://gowander:change-me@localhost:5432/gowander?sslmode=disable

HTTP_ADDR=:8080
APP_ENV=development
LOG_LEVEL=info
